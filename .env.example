# Copy to .env for local development. Never commit real values.
# On Vercel: Project -> Settings -> Environment Variables (same names).

# Apify — LinkedIn profile reader for the "Try it now" outreach demo
APIFY_TOKEN=
APIFY_ACTOR=harvestapi~linkedin-profile-scraper

# Resend — sends the invite email (domain kriyvoai.online must be verified)
RESEND_API_KEY=
INVITE_FROM="Kriyvo AI <hello@kriyvoai.online>"

# Public site URL used in invite links
SITE_URL=https://kriyvoai.online

# Random secret that signs demo sessions. Generate with: openssl rand -hex 32
PLAYGROUND_SECRET=

# Optional bot protection (recommended before launch)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional: comma-separated hostnames allowed to send tokens (default: kriyvoai.online, www., kriyvo-ai.netlify.app)
TURNSTILE_HOSTNAMES=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live demos (chatbot, WhatsApp funnel, feedback classifier, voice) — server-only
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Optional: tried when the main model is rate limited or down
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Voice demo: ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
